# Copy to .env (git-ignored). Never commit real values.
# Variables are read with the MP_ prefix. See src/marketpulse/config.py.

MP_ENVIRONMENT=local            # local | test | staging | production
MP_LOG_LEVEL=INFO
MP_LOG_JSON=false

# PostgreSQL (Neon POOLED connection string, connected as the marketpulse_app role).
# Leave empty to run without a database; /health/ready will then report 503, honestly.
MP_DATABASE_URL=

# PostgreSQL DIRECT (non-pooled) connection string, connected as the project OWNER role.
# Used only by Alembic migrations and the app-role bootstrap script (ADR-0023).
# Neon: the "Direct connection" string from the Connect dialog (host has no -pooler).
MP_DATABASE_DIRECT_URL=

# The application database role created by scripts/db/bootstrap_app_role.py.
# Must NOT be BYPASSRLS. The integration test asserts rolbypassrls = false (ADR-0022).
MP_DB_APP_ROLE=marketpulse_app
MP_DB_APP_PASSWORD=             # leave empty until bootstrap_app_role.py sets it

# Redis (Redis Cloud). Only needed for the worker. rediss:// means TLS.
MP_REDIS_URL=

# Neon can take a few seconds to wake from idle.
MP_PROBE_TIMEOUT_SECONDS=10

# Phase 1 ONLY: a dev/test header resolver that trusts X-MP-Organization / X-MP-User to
# set the tenant context. This is replaced by auth-backed resolution in Phase 2.
# Allowed only in local/test. The app refuses to start if true in staging/production.
MP_ENABLE_DEV_TENANT_HEADER=true

# Must be JSON when set as an environment variable.
MP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
